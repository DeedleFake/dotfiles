# Matches ~/.config/foot/foot.ini: font=Go Mono:size=8
font-family = "Go Mono"
font-size = 8

# Matches foot [colors-dark] alpha=.9. Opacity applies to the default
# background only, which is foot's default alpha-mode.
background-opacity = 0.9

# Fullscreen was ctrl+enter by default.
keybind = ctrl+enter=unbind
keybind = f11=toggle_fullscreen

# GNOME's Ctrl+Alt+T shortcut joins the running process. Do not copy the
# focused window's directory; start in $HOME instead.
window-inherit-working-directory = false
working-directory = home
